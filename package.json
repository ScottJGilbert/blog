    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1",
    "lighthouse": "^12",
    "prettier": "^3",
    "typescript": "^5"
  }
}
