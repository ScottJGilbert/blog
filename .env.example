# Copy to .env (root) — apps read from process env; see docs/SPEC.md §3 for the full list
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
TEST_DATABASE_URL=postgres://blog:blog@localhost:5432/blog_test
# Supabase (production/preview, see docs/DEPLOYMENT.md §1): DATABASE_URL = transaction pooler :6543, DATABASE_URL_UNPOOLED = session pooler/direct,
# or just the POSTGRES_URL / POSTGRES_URL_NON_POOLING that Vercel's Supabase integration injects. TLS: DATABASE_SSL_CA (PEM or base64) or DATABASE_SSL=no-verify.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
ADMIN_EMAILS=you@example.com

# --- docker compose (docs/LOCAL_DEV.md): optional overrides, all have dev defaults ---
# PORT=3000
# PUBLIC_URL=http://localhost:3000
# SEED_DB=1
# EMBEDDING_API_KEY=
