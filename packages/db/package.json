{
  "name": "@blog/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/seed.ts",
    "test": "vitest run --passWithNoTests",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@blog/content": "workspace:*",
    "@blog/shared": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.44",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "drizzle-kit": "^0.31",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
