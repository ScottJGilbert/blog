# Copy to apps/web/.env.local. Everything is optional in development. See docs/SPEC.md §3.

# Server-side URL web uses to reach the API (Server Components, /feed.xml, newsletter pages).
API_INTERNAL_URL=http://localhost:4000
# Path prefix of the API on that origin (default /api).
# API_BASE_PATH=/api

# Public origin of the site: metadataBase, canonical URLs, sitemap, robots, JSON-LD.
# Unset in a production build => VERCEL_PROJECT_PRODUCTION_URL, else https://blog.scottgilbert.dev (never localhost).
SITE_URL=http://localhost:3000

# Shared secret for POST /internal/revalidate (header x-revalidate-secret). Must equal the API's REVALIDATE_SECRET.
# The route answers 404 while this is unset. The API calls it through WEB_REVALIDATE_URL
# (e.g. http://localhost:3000/internal/revalidate).
REVALIDATE_SECRET=

# Dev topology: `next dev` rewrites /api/* -> API_INTERNAL_URL and /admin/* -> ADMIN_DEV_URL so the browser sees one
# origin like in production. Set DEV_PROXY=1 to keep the rewrites in a production build (local `next start` tests).
# Production must NOT define /api routes in web: the platform routes /api to the API service.
# DEV_PROXY=1
# ADMIN_DEV_URL=http://localhost:3001

# Social sign-in buttons (show them only when the API has the matching GOOGLE_*/GITHUB_* credentials).
# NEXT_PUBLIC_AUTH_GOOGLE=1
# NEXT_PUBLIC_AUTH_GITHUB=1

# Extra hostnames cover/content images may come from through next/image (comma separated), e.g. a CDN in front of the
# blob store. Always allowed: *.public.blob.vercel-storage.com, picsum.photos (seed data) and same-origin
# /api/media/files/* paths.
# NEXT_PUBLIC_MEDIA_HOST=cdn.example.com
