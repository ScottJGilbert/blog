# apps/admin — copy to apps/admin/.env.local (see docs/SPEC.md §3).
# Server-side URL of the API service. Used by the `/api/*` rewrite (read at BUILD time by `next build`)
# and by server components that check the session (`/api/me`).
API_INTERNAL_URL=http://localhost:4000

# Public origin of the *site* (for "View on site" / preview links). Leave empty when the site and the admin share one
# origin (production, or dev through the web app's proxy). Standalone dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
