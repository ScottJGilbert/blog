# Copy to apps/api/.env (or the repo-root .env). See docs/SPEC.md §3. Everything is optional in development.

# --- core -----------------------------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
# integration tests (a throw-away database per test file is created next to it)
TEST_DATABASE_URL=postgres://blog:blog@localhost:5432/blog_test
API_PORT=4000
API_BASE_PATH=/api
# how web/admin server code reaches this API
API_INTERNAL_URL=http://localhost:4000
# reverse-proxy hops to trust for client IPs (Vercel: 1)
TRUST_PROXY=1
LOG_LEVEL=debug

# --- auth (Better Auth) ---------------------------------------------------------------------------------
# REQUIRED in production, >= 32 random chars:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# public origin users see (links in emails are built from this); same as SITE_URL on a single domain
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
SITE_NAME=Scott Gilbert
# extra browser origins allowed for cookie-authenticated writes (comma list)
TRUSTED_ORIGINS=
# accounts with these emails become admin once their email is verified (comma list)
ADMIN_EMAILS=you@example.com
# false = unverified users may sign in (they still cannot comment)
REQUIRE_EMAIL_VERIFICATION=true
# social sign-in is enabled only when both values of a pair are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- email ----------------------------------------------------------------------------------------------
# console = log to the terminal (dev), smtp = nodemailer, resend = Resend HTTP API
MAILER_DRIVER=console
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM="Scott Gilbert <no-reply@localhost>"

# --- media ----------------------------------------------------------------------------------------------
# local = files under UPLOAD_DIR, served at /api/media/files/*; vercel-blob needs BLOB_READ_WRITE_TOKEN
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
BLOB_READ_WRITE_TOKEN=

# --- embeddings / semantic search (disabled while EMBEDDING_API_KEY is empty) -----------------------------
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- newsletters (listmonk; no-op provider while LISTMONK_URL is empty) ----------------------------------
LISTMONK_URL=
LISTMONK_USER=
LISTMONK_API_TOKEN=
LISTMONK_LIST_ID=
LISTMONK_WEBHOOK_SECRET=
# optional: token (default, "Authorization: token user:token") | basic
LISTMONK_AUTH_SCHEME=token
# optional: campaign template id (default: auto-managed pass-through template) and campaign from address
LISTMONK_TEMPLATE_ID=
LISTMONK_FROM_EMAIL=

# --- web integration ------------------------------------------------------------------------------------
# POST { tags: [...] } with header x-revalidate-secret
WEB_REVALIDATE_URL=http://localhost:3000/internal/revalidate
REVALIDATE_SECRET=
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# rate limits are on by default (off under NODE_ENV=test); set 0 to disable locally
RATE_LIMIT_ENABLED=1
