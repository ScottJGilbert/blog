{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }
      ]
    },
    "admin": {
      "root": "apps/admin/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }
      ]
    },
    "api": {
      "root": "apps/api/",
      "framework": "express",
      "entrypoint": "entry.cjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/admin", "destination": { "service": "admin" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/cron/publish-scheduled", "schedule": "0 6 * * *" }
  ]
}
